{
  "name": "internship-api",
  "version": "1.0.0",
  "description": "A REST API and Persistent Data project for Internship Management built with Node.js, Express, and SQLite.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node database/init.js --schema-only",
    "db:seed": "node database/init.js --seed",
    "test": "node tests/run-tests.js",
    "demo": "node scripts/demo.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "sqlite",
    "rest-api",
    "crud",
    "internship-task",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "morgan": "^1.12.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}